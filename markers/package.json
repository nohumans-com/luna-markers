    "vendor": "node scripts/vendor-sdk.mjs"
  },
  "devDependencies": {
    "@uaudio/luna-builder-sdk": "file:../../../Library/Application Support/LUNA Builder SDK/plugins/ua-luna-builder",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
