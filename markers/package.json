{
  "name": "markers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Markers, a LUNA Add On built with @uaudio/luna-builder-sdk",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "ua-builder serve",
    "install-addon": "ua-builder install",
    "build": "node scripts/sync-window.mjs",
